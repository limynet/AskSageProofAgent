# ============================================================================
# LLM Client Configuration - Two-Outlet Architecture
# ============================================================================
# The app exposes exactly two LLM outlets:
#   Outlet 1 - local:  Bonsai-1.7B served by a llama-server process
#                      (deepgrove llama.cpp fork), OpenAI-compatible API.
#   Outlet 2 - custom: a generic, user-configured OpenAI-compatible endpoint.
#                      AskSage is just one possible value the user may set.
#
# Precedence: environment variables injected by Docker WIN over the values
# in this file. python-dotenv does not override already-set env vars.

# --- Outlet 1: local (Bonsai llama-server) ----------------------------------
# Base URL of the OpenAI-compatible endpoint. Inside Docker use
# http://maple-llm:8080/v1 ; for local dev use http://localhost:8080/v1.
LOCAL_API_BASE=http://localhost:8080/v1

# Model name served by the local engine. Set to the exact id (alias) the
# running llama-server reports in /v1/models, e.g. "bonsai-1.7b".
LOCAL_MODEL=bonsai-1.7b

# API key for the local endpoint. llama-server ignores it, but the OpenAI
# SDK requires a non-empty string.
LOCAL_API_KEY=sk-local

# Display-only value: which GGUF quant variant is running. Used purely for
# the UI to show which quant is active. Not used for any connection logic.
LOCAL_GGUF_VARIANT=Q1_0

# --- Outlet 2: custom (generic OpenAI-compatible endpoint) ------------------
# Leave these empty to disable the custom outlet. When the "local" outlet
# fails, the client automatically falls back to the custom outlet only if
# ALL three variables below are set.
#
# Example: using AskSage as the custom outlet:
#   CUSTOM_API_BASE=https://api.asksage.ai/v1
#   CUSTOM_MODEL=gpt-5.1-gov
#   CUSTOM_API_KEY=your_asksage_api_key_here
CUSTOM_API_BASE=
CUSTOM_MODEL=
CUSTOM_API_KEY=

# --- Request behavior -------------------------------------------------------
# Two timeouts with different jobs.
# LLM_CONNECT_TIMEOUT: reachability probe timeout (Test connection button).
#   Short, so an unreachable engine fails fast with an actionable error.
# LLM_REQUEST_TIMEOUT: generation timeout. The local Bonsai model is a 1.7B
# CPU-bound model that can take a while on a large stage call, so this
# defaults long (900s).
# The OpenAI SDK retry loop is disabled, so a failed request is reported
# immediately rather than retried silently.
LLM_CONNECT_TIMEOUT=8
LLM_REQUEST_TIMEOUT=900